[run]
source = app
branch = False
# R3: necesario para medir correctamente el código que corre tras `await` de SQLAlchemy
# (asyncio/greenlet); sin esto la cobertura sub-mide los servicios async.
concurrency = greenlet
omit =
    app/db/migrations/*
    app/services/intelligence.py
    app/schemas/response_examples.py
    demo_bad_code.py
    tests/*

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
